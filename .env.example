# =============================================================================
# Optional overrides for docker compose. Copy to `.env` next to docker-compose.yml.
# Every value below is already the default — only set what you want to change.
# =============================================================================

# --- Security (set these on any shared network) ------------------------------
POSTGRES_PASSWORD=change-me-rag
# When set, every /api call needs header  X-API-Key: <value>  (the UI asks once).
RAG_API_KEY=

# --- Ports / resources (sized for an 8 GB, 4-core industrial PC) --------------
RAG_PORT=1000
API_MEMORY=1536m
WORKER_MEMORY=2g
# CPU cores for background indexing (runs at low priority; raise for bulk loads)
WORKER_CPUS=2
QDRANT_MEMORY=2g
OLLAMA_MEMORY=4g
PG_MEMORY=1g

# --- Local LLM (baked into the ollama image at build time) -------------------
# CPU only, 8 GB RAM : qwen2.5:3b   (default; ~2 GB)
# Very small boxes   : qwen2.5:1.5b (~1 GB, faster, less fluent)
# 16 GB RAM / GPU    : qwen2.5:7b   (~4.7 GB, best quality)
# After changing: docker compose build ollama && docker compose up -d
RAG_LLM_MODEL=qwen2.5:3b
RAG_LLM_TAG=qwen2.5-3b
RAG_LLM_NUM_CTX=4096
RAG_LLM_MAX_TOKENS=300

# --- Retrieval ----------------------------------------------------------------
RAG_TOP_K=6
# Reranker score below which a question is answered "not in the documents"
# (unless an exact alarm code / tag match is found). Raise to be stricter.
RAG_MIN_RELEVANCE=-4.0
# ONNX threads per model call (0 = automatic).
RAG_MODEL_THREADS=0

# --- Ingestion ----------------------------------------------------------------
# Seconds between scans of the media folder for new/changed/removed files.
RAG_AUTO_SCAN_SECONDS=60
RAG_INGEST_BATCH_SIZE=256
# Heavier layout-aware PDF parser (adds ~2 GB to the worker image).
WITH_DOCLING=false

# --- Logging ------------------------------------------------------------------
RAG_LOG_LEVEL=INFO
